<Window
  x:Class="TimeTracker.Dialogs.LongRunningJobDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:utils="clr-namespace:TimeTracker.Utils"
  Title="Long running job"
  Width="520"
  Height="300"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Background="White"
  FontFamily="Segoe UI"
  mc:Ignorable="d">

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static utils:Palette.AccentDeepColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{x:Static utils:Palette.PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{x:Static utils:Palette.SecondaryTextColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{x:Static utils:Palette.WarningColor}" />

    <Style x:Key="DialogButtonBaseStyle" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="{x:Static utils:Palette.Panel}" />
      <Setter Property="BorderBrush" Value="{x:Static utils:Palette.InputBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{x:Static utils:Palette.Highlight}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{x:Static utils:Palette.HighlightBorder}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style
      x:Key="DialogPrimaryButtonStyle"
      BasedOn="{StaticResource DialogButtonBaseStyle}"
      TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{x:Static utils:Palette.AccentHover}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{x:Static utils:Palette.AccentHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style
      x:Key="DialogDangerButtonStyle"
      BasedOn="{StaticResource DialogButtonBaseStyle}"
      TargetType="Button">
      <Setter Property="Background" Value="{x:Static utils:Palette.Danger}" />
      <Setter Property="BorderBrush" Value="{x:Static utils:Palette.Danger}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{x:Static utils:Palette.DangerHover}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{x:Static utils:Palette.DangerHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <Border
      Grid.Row="0"
      Padding="28,0"
      BorderBrush="{x:Static utils:Palette.DialogRule}"
      BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border
          Width="28"
          Height="28"
          Margin="0,0,12,0"
          Background="{StaticResource WarningBrush}"
          CornerRadius="6">
          <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
            FontSize="14"
            Foreground="White"
            Text="&#xE7BA;" />
        </Border>
        <TextBlock
          VerticalAlignment="Center"
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{StaticResource PrimaryTextBrush}"
          Text="Long running job" />
      </StackPanel>
    </Border>

    <StackPanel
      Grid.Row="1"
      Margin="28,24,28,0"
      VerticalAlignment="Top">
      <TextBlock
        x:Name="MessageTextBlock"
        FontSize="16"
        Foreground="{StaticResource PrimaryTextBrush}"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="JobTextBlock"
        Margin="0,14,0,0"
        FontSize="15"
        FontWeight="SemiBold"
        Foreground="{StaticResource PrimaryTextBrush}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        x:Name="DetailTextBlock"
        Margin="0,6,0,0"
        FontSize="14"
        Foreground="{StaticResource SecondaryTextBrush}"
        TextWrapping="Wrap" />
    </StackPanel>

    <Border
      Grid.Row="2"
      Padding="28,0"
      BorderBrush="{x:Static utils:Palette.DialogRule}"
      BorderThickness="0,1,0,0">
      <Grid>
        <Button
          x:Name="StopButton"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="StopButton_Click"
          Content="Stop"
          Style="{StaticResource DialogDangerButtonStyle}" />
        <Button
          x:Name="ContinueButton"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Click="ContinueButton_Click"
          Content="Continue"
          IsDefault="True"
          Style="{StaticResource DialogPrimaryButtonStyle}" />
      </Grid>
    </Border>
  </Grid>
</Window>
