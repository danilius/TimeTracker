<Window
  x:Class="TimeTracker.Dialogs.ReportPreviewWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:utils="clr-namespace:TimeTracker.Utils"
  Title="Report"
  Width="900"
  Height="700"
  MinWidth="560"
  MinHeight="420"
  WindowStartupLocation="CenterOwner"
  Background="White"
  FontFamily="Segoe UI"
  mc:Ignorable="d">

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static utils:Palette.AccentDeepColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{x:Static utils:Palette.PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{x:Static utils:Palette.SecondaryTextColor}" />

    <Style x:Key="DialogButtonBaseStyle" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="Background" Value="{x:Static utils:Palette.Panel}" />
      <Setter Property="BorderBrush" Value="{x:Static utils:Palette.InputBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{x:Static utils:Palette.Highlight}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{x:Static utils:Palette.HighlightBorder}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style
      x:Key="DialogPrimaryButtonStyle"
      BasedOn="{StaticResource DialogButtonBaseStyle}"
      TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{x:Static utils:Palette.AccentHover}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{x:Static utils:Palette.AccentHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <Border
      Grid.Row="0"
      Padding="28,0"
      BorderBrush="{x:Static utils:Palette.DialogRule}"
      BorderThickness="0,0,0,1">
      <StackPanel VerticalAlignment="Center">
        <TextBlock
          x:Name="TitleTextBlock"
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{StaticResource PrimaryTextBrush}"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          x:Name="SubtitleTextBlock"
          Margin="0,4,0,0"
          FontSize="14"
          Foreground="{StaticResource SecondaryTextBrush}"
          TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <FlowDocumentScrollViewer
      x:Name="DocumentViewer"
      Grid.Row="1"
      Margin="0"
      Padding="0"
      Background="{x:Static utils:Palette.Panel}"
      IsToolBarVisible="False"
      VerticalScrollBarVisibility="Auto" />

    <Border
      Grid.Row="2"
      Padding="28,0"
      BorderBrush="{x:Static utils:Palette.DialogRule}"
      BorderThickness="0,1,0,0">
      <StackPanel
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <Button
          x:Name="SaveButton"
          Click="SaveButton_Click"
          Content="Save as Word"
          Style="{StaticResource DialogButtonBaseStyle}" />
        <Button
          x:Name="PrintButton"
          Click="PrintButton_Click"
          Content="Print"
          Style="{StaticResource DialogButtonBaseStyle}" />
        <Button
          x:Name="CloseButton"
          Click="CloseButton_Click"
          Content="Close"
          IsCancel="True"
          IsDefault="True"
          Style="{StaticResource DialogPrimaryButtonStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
